# TLM RNF/HNF testbench — pure Questa SV+SC co-simulation
#
# Usage (run from cva6-RNF/tb/):
#   make QUESTA=/path/to/questa all    # compile SC model + SV/RTL
#   make QUESTA=/path/to/questa sim    # batch simulation
#   make QUESTA=/path/to/questa wave   # interactive with waveforms
#   make clean                         # remove questa_build/
#
# PROJ_ROOT is the repo root (parent of cva6-RNF/).  It is auto-detected
# from the Makefile location but can be overridden on the command line.

QUESTA    ?= $(error QUESTA is not set — e.g. make QUESTA=/opt/questa <target>)
PROJ_ROOT ?= $(abspath ../..)
BUILD     := questa_build
TESTGEN   := testgen
# SV+SC / gem5 co-simulation sources (TB tops, SystemC RN-F bridge,
# sc_main stub, TLM file list, gem5 coverage bind).
COSIM     := cosim

# ── Test-generator knobs (override on the make command line) ─────────────────
# REPLAY=1     → compile chi_tlm_rnf.cpp with -DRNF_REPLAY_DEMO, link in
#                testgen/replay_vector.cpp, and use REPLAY_VECTOR at runtime.
# MSHR_OBS=1   → compile testgen/mshr_observer.sv + mshr_observer_bind.sv
#                so the HNF MSHR emits [MSHR_OBS] trace lines.
# SEED, CHAIN, COUNT  → forwarded to fuzz_sequences.py.
# VECTOR, SIMLOG      → forwarded to oracle.py / replay run.
REPLAY    ?= 0
MSHR_OBS  ?= 0
# HNF_ASSERT=1 → +define+DISPLAY_FATAL (protocol/state-corruption $fatal)
# HNF_TRACE=1  → +define+DISPLAY_INFO  (verbose per-flit/per-stage $display)
HNF_ASSERT ?= 0
HNF_TRACE  ?= 0
# COVERAGE=1  → compile with `vlog -cover bcs`, instantiate the MSHR
#               coverage observer, run vsim with -coverage, and save a
#               per-vector .ucdb. Merge with `make testgen-coverage-merge`,
#               HTML report via `make testgen-coverage-report`.
COVERAGE   ?= 0
# Propagate to recipes / sub-scripts so `make COVERAGE=1 testgen-run-*`
# behaves the same as `COVERAGE=1 make testgen-run-*`.
export COVERAGE
# ICN=behavioral (default) → chi_icn_beh.sv
# ICN=mesh                 → OpenNoC 2x2 mesh via chi_icn_mesh.sv adapter
#                            (requires mesh_wrapper_2x2.sv pre-generated by
#                             opennoc/tools/mesh_generator/mesh_gen.py)
ICN        ?= behavioral
# SNF=tbsnf (default) → tb_snf.v (lightweight SV behavioural SRAM)
# SNF=memss           → mem_ss.sv (real RTL SNF + axi2mem + tb_snf_sram backing)
SNF        ?= tbsnf
SEED      ?= 0
CHAIN     ?= 4
COUNT     ?= 1
VECTOR    ?= $(TESTGEN)/vectors/UC_A__REQ_A_Evict.txt
SIMLOG    ?= $(BUILD)/sim.log

SCCOM_DEFS :=
ifeq ($(REPLAY),1)
SCCOM_DEFS += -DRNF_REPLAY_DEMO
endif
ifeq ($(ICN),mesh)
# OpenNoC mesh: HNF lives at XP(1,0)/P0 → NID = {X=1,Y=0,P=0} = 16.
SCCOM_DEFS += -DHNF_NID_DEFAULT=16
endif

# ── CHI DAT-flit width (128 / 256 / 512).  Default 256 matches the
#    upstream RTL default (CHIE_DATA_WIDTH_PARAM=256, 2 beats/64B line).
#    Overriding CHI_DW re-derives:
#      * SC bridge: CHI_DAT_W + DAT_{BE,DATA}_LSB/MSB via a single
#        formula in chi_tlm_rnf.h,
#      * SV port stub: uses `CHIE_DAT_FLIT_WIDTH` macro which resolves
#        from the SV parameter — override via VLOG_DEFS below,
#      * RTL / chi_icn_beh / chi_monitor / HN-F BFM: all already keyed
#        off the same CHIE_DATA_WIDTH_PARAM (see chie_defines.v).
CHI_DW    ?= 256
SCCOM_DEFS += -DCHI_DATA_BEAT_BITS=$(CHI_DW)
# The RTL side reads the width from the top-module parameter.  Since
# tlm_rnf_hnf_tb.sv declares `parameter CHIE_DATA_WIDTH_PARAM = 256;`
# at module scope, we override it at elaboration via vopt -G so all
# child instantiations (chi_tlm_rnf, chi_icn_beh, chi_monitor, HN-F,
# SNF) receive the matching width without touching source.
VSIM_CHI_DW_G := -G tlm_rnf_hnf_tb.CHIE_DATA_WIDTH_PARAM=$(CHI_DW)

SV_TESTGEN :=
ifeq ($(MSHR_OBS),1)
SV_TESTGEN += ../$(TESTGEN)/mshr_observer.sv ../$(TESTGEN)/mshr_observer_bind.sv
endif
ifeq ($(COVERAGE),1)
SV_TESTGEN += ../$(TESTGEN)/mshr_coverage.sv ../$(TESTGEN)/coherence_coverage.sv \
              ../$(TESTGEN)/atomic_coverage.sv \
              ../$(TESTGEN)/mshr_coverage_bind.sv \
              ../$(TESTGEN)/atomic_coverage_bind.sv
endif

VLOG_DEFS :=
ifeq ($(HNF_ASSERT),1)
VLOG_DEFS += +define+DISPLAY_FATAL
endif
ifeq ($(HNF_TRACE),1)
VLOG_DEFS += +define+DISPLAY_INFO
endif

# Mesh ICN files. Compiled in addition to chi_icn_beh.sv when ICN=mesh.
# tlm_rnf_hnf_tb.sv picks one instantiation under `ifdef ICN_MESH`.
SV_ICN_MESH :=
ifeq ($(ICN),mesh)
VLOG_DEFS   += +define+ICN_MESH
# Paths are relative to BUILD (tb/questa_build/), so go up two levels
# (questa_build → tb → cva6-RNF) before descending into opennoc/.
SV_ICN_MESH := ../../opennoc/rtl/misc/xp_sel_bit_from_vec.v \
               ../../opennoc/rtl/misc/chi_xp_channel.v \
               ../../src/mesh/chi_xp_node.sv \
               ../../src/mesh/mesh_wrapper_2x2.sv \
               ../chi_icn_mesh.sv
endif

# mem_ss SNF (real RTL snf + axi2mem + AXI_BUS interface) when SNF=memss.
# tlm_rnf_hnf_tb.sv picks mem_ss vs tb_snf under `ifdef TB_MEM_SS`.
SV_MEM_SS :=
ifeq ($(SNF),memss)
VLOG_DEFS += +define+TB_MEM_SS \
             +incdir+../../singlecore-cva6/tile/ariane/corev_apu/axi/include
SV_MEM_SS := ../../singlecore-cva6/tile/ariane/corev_apu/axi/src/axi_pkg.sv \
             ../../singlecore-cva6/tile/ariane/corev_apu/axi/src/axi_intf.sv \
             ../../axi2mem/src/axi2mem.sv
endif

# Coverage-collection flags forwarded to vlog/vsim
VLOG_COV   :=
VSIM_COV   :=
ifeq ($(COVERAGE),1)
VLOG_COV   := +cover=bcestf
VSIM_COV   := -coverage
endif

.PHONY: all sc sv sim wave clean \
        testgen-summary testgen-vectors testgen-fuzz testgen-extract \
        testgen-oracle  testgen-replay  testgen-clean testgen-dot \
        testgen-run-all testgen-run-bfs testgen-run-fuzz testgen-run-murphi \
        testgen-burst   testgen-run-burst testgen-run-sweep \
        testgen-cross   testgen-run-cross \
        testgen-run-smoke testgen-run-subset \
        testgen-coverage-merge testgen-coverage-report \
        testgen-coverage-merge-bfs testgen-coverage-merge-burst testgen-coverage-merge-cross \
        testgen-coverage-xml testgen-coverage-summary \
        testgen-expand-hazards testgen-murphi testgen-murphi-dot

all: sc sv

# ── Initialise Questa work library (once) ────────────────────────────────────
$(BUILD)/.vlib_done:
	mkdir -p $(BUILD)
	cd $(BUILD) && vlib work && vmap work work
	@touch $@

# ── Compile the SystemC RN-F model ───────────────────────────────────────────
# Uses sccom -link so that Questa embeds the SC library into the work library
# at work/_sc/linux_x86_64_gcc-*/systemc.so.  vsim auto-discovers it from
# there — no -sclib needed.  $(COSIM)/questa_sc_main.cpp provides a minimal sc_main()
# (must exist but must NOT create SC instances; SC_MODULE_EXPORT handles
# binding when SV instantiates chi_tlm_rnf from tlm_rnf_hnf_tb.sv).
$(BUILD)/.sc_done: $(COSIM)/chi_tlm_rnf.cpp $(COSIM)/chi_tlm_rnf.h \
                   $(COSIM)/questa_sc_main.cpp \
                   $(TESTGEN)/replay_vector.cpp $(TESTGEN)/replay_vector.h \
                   | $(BUILD)/.vlib_done
	cd $(BUILD) && \
	sccom -suppress sccom-94 -O2 -std=c++14 -I.. $(SCCOM_DEFS) ../$(COSIM)/chi_tlm_rnf.cpp && \
	sccom -suppress sccom-94 -O2 -std=c++14 -I.. ../$(TESTGEN)/replay_vector.cpp && \
	sccom -suppress sccom-94 -O2 -std=c++14 ../$(COSIM)/questa_sc_main.cpp && \
	sccom -suppress sccom-94 -link
	@touch $@

sc: $(BUILD)/.sc_done

# ── Compile SV/RTL sources ────────────────────────────────────────────────────
# Single-pass MFCU compile. The testgen observer + bind file go into the
# SAME compilation unit as hnf_mshr_ctl so the bind directive elaborates
# (cross-CU bind resolution is unreliable on some Questa builds).
# vlog-2650 ("'bind' found in compilation unit scope") is suppressed —
# it's a non-fatal hint that doesn't affect elaboration in MFCU mode.
sv: $(BUILD)/.sc_done
	cd $(BUILD) && \
	PROJ_ROOT=$(PROJ_ROOT) \
	vlog -sv -work work -mfcu -suppress 2583 -suppress 3009 -suppress 2650 \
	     $(VLOG_DEFS) $(VLOG_COV) -f ../$(COSIM)/chi_tlm_flist $(SV_TESTGEN) $(SV_ICN_MESH) $(SV_MEM_SS)

# ── Batch simulation ──────────────────────────────────────────────────────────
# Optional plusargs (append to SIMARGS on the command line):
#   SIMARGS="+rnf_verbose"           — SC RN-F per-step trace
#   SIMARGS="+mon_verbosity+2"       — chi_monitor verbosity (0/1/2, default=1)
#   SIMARGS="+icn_debug"             — ICN behavioral model flit-level trace
# Example:
#   make QUESTA=... sim SIMARGS="+rnf_verbose +mon_verbosity+2 +icn_debug"
SIMARGS ?=
UCDB    ?= cov.ucdb
# When COVERAGE=1, use -onfinish stop so the TB's $finish doesn't kill
# vsim before `coverage save` runs in the -do script.
VSIM_ONFIN := $(if $(filter 1,$(COVERAGE)),-onfinish stop,)
COV_SAVE   := $(if $(filter 1,$(COVERAGE)),coverage save $(UCDB);,)
sim:
	cd $(BUILD) && vsim -c -t 10ps -voptargs="+acc" -suppress 3009 $(VSIM_COV) $(VSIM_ONFIN) $(VSIM_CHI_DW_G) work.tlm_rnf_hnf_tb $(SIMARGS) \
	    -do "log -r /*; run -all; $(COV_SAVE) quit -f;"

# ── Interactive simulation with waveform logging ──────────────────────────────
wave:
	cd $(BUILD) && \
	vsim -suppress 3009 $(VSIM_COV) $(VSIM_ONFIN) $(VSIM_CHI_DW_G) work.tlm_rnf_hnf_tb $(SIMARGS) \
	    -do "log -r /*; run -all; $(COV_SAVE) wave zoom full"

# ── IP-level RN-F testbench (CVA6-less, L1.5+rnf_link DUT) ─────────
# Uses tb/rnf_ip_tb.sv + tb/chi_hnf_responder.sv driven by rnf_ip_flist.
# No SystemC, no gem5: pure SV smoke harness for the L1.5 coherence FSM.
# Compile + run:
#   make QUESTA=/path/to/questa rnf-ip-sim
# Coverage sources are compiled in the same CU as the TB so the bind
# directive resolves; gated on COVERAGE=1.
SV_RNF_IP_COV :=
ifeq ($(COVERAGE),1)
# Package must compile first; vlog -mfcu handles ordering correctly
# inside the single compile unit but we list the package up front
# anyway for clarity.
SV_RNF_IP_COV := ../rnf_coverage/rnf_cov_pkg.sv \
                 ../rnf_coverage/rnf_phase_tracker.sv \
                 ../rnf_coverage/rnf_coverage.sv \
                 ../rnf_coverage/rnf_coverage_bind.sv
endif

rnf-ip-compile: | $(BUILD)/.vlib_done
	cd $(BUILD) && \
	PROJ_ROOT=$(PROJ_ROOT) \
	vlog -sv -work work -mfcu -suppress 2583 -suppress 3009 -suppress 2650 \
	     $(VLOG_DEFS) $(VLOG_COV) -f ../rnf_ip_flist \
	     ../chi_hnf_responder.sv ../rnf_ip_tb.sv $(SV_RNF_IP_COV)

RNF_IP_UCDB ?= rnf_ip_cov.ucdb
rnf-ip-sim: rnf-ip-compile
	cd $(BUILD) && vsim -c -t 10ps -voptargs="+acc" -suppress 3009 \
	    $(VSIM_COV) $(VSIM_ONFIN) work.rnf_ip_tb \
	    -do "log -r /*; run -all; $(if $(filter 1,$(COVERAGE)),coverage save $(RNF_IP_UCDB);,) quit -f;"

rnf-ip-wave: rnf-ip-compile
	cd $(BUILD) && vsim -suppress 3009 work.rnf_ip_tb \
	    -do "log -r /*; run -all; wave zoom full"

# ── Remove all build artifacts ────────────────────────────────────────────────
clean:
	rm -rf $(BUILD)

# ──────────────────────────────────────────────────────────────────────────────
# Test-case generator pipeline (cva6-RNF/tb/testgen/)
# ──────────────────────────────────────────────────────────────────────────────
# All Python tools live under $(TESTGEN). PyYAML is the only external dep
# (pip install --user --break-system-packages pyyaml).

# FSM reachability + coverage report
testgen-summary:
	cd $(TESTGEN) && python3 ./gen_sequences.py --summary

# Emit one BFS-shortest-path vector per (state, event) target
testgen-vectors:
	cd $(TESTGEN) && python3 ./gen_sequences.py --vectors

# Random N-target FSM walks. Override SEED / CHAIN / COUNT:
#   make testgen-fuzz SEED=42 CHAIN=8 COUNT=20
testgen-fuzz:
	cd $(TESTGEN) && python3 ./fuzz_sequences.py \
	    --seed $(SEED) --chain $(CHAIN) --count $(COUNT)

# Parse chie_defines.v + hnf_mshr_ctl.v, cross-check against hnf_fsm.yaml
testgen-extract:
	cd $(TESTGEN) && python3 ./extract_rtl.py

# Diff a vector against a sim log containing [MSHR_OBS] lines:
#   make testgen-oracle VECTOR=testgen/vectors/UC_A__REQ_A_Evict.txt SIMLOG=questa_build/sim.log
testgen-oracle:
	python3 $(TESTGEN)/oracle.py $(VECTOR) $(SIMLOG)

# End-to-end replay: rebuild SC with -DRNF_REPLAY_DEMO, attach the MSHR
# observer via bind, run the chosen VECTOR, tee the sim log, then score
# it with the oracle. Defaults to the single-RN-F UC_A->Evict vector.
#   make testgen-replay VECTOR=testgen/vectors/SC_AB__REQ_B_CleanUnique.txt
testgen-replay:
	$(MAKE) clean
	$(MAKE) all REPLAY=1 MSHR_OBS=1
	cd $(BUILD) && REPLAY_VECTOR=../$(VECTOR) vsim -c -t 10ps -voptargs="+acc" \
	    work.tlm_rnf_hnf_tb $(SIMARGS) \
	    -do "log -r /*; run -all; exit;" 2>&1 | tee $(notdir $(SIMLOG))
	mv -f $(BUILD)/$(notdir $(SIMLOG)) $(SIMLOG)
	$(MAKE) testgen-oracle VECTOR=$(VECTOR) SIMLOG=$(SIMLOG)

# Render the HN-F FSM as Graphviz DOT + PNG (requires graphviz: `dot`)
testgen-dot:
	cd $(TESTGEN) && python3 ./to_dot.py -o hnf_fsm.dot --render

# Expand the FSM with composite pending-REQ states (CAM-hazard handling).
# Run after editing the base FSM in hnf_fsm.yaml to regenerate the
# auto-generated `__PEND_<peer>_<op>` states + edges.
testgen-expand-hazards:
	cd $(TESTGEN) && python3 ./expand_hazards.py

# Verify the Murphi protocol model. Requires `rumur` on PATH (or via
# RUMUR var) plus a C compiler. Builds the model into a C verifier,
# runs it, and reports the reachable-state count + any invariant
# violations. Exits non-zero on any violation.
RUMUR ?= /home/dmk/fedora/rumur/build/rumur/rumur
testgen-murphi:
	cd $(TESTGEN)/murphi && \
	    $(RUMUR) --output hnf_fsm.c hnf_fsm.m && \
	    cc -std=c11 -march=native -mcx16 -O3 -o hnf_fsm hnf_fsm.c -lpthread && \
	    ./hnf_fsm | tail -15

# Render the Murphi state space as a Graphviz DOT diagram.
# Patches the model with state-dump Puts, runs the verifier, parses
# the trace, emits hnf_fsm_murphi.dot + .png.
testgen-murphi-dot:
	cd $(TESTGEN)/murphi && python3 ./to_dot.py

# Run every generated vector through a fresh vsim invocation. Requires
# the design already built with REPLAY=1 MSHR_OBS=1 (otherwise the replay
# code path is compiled out and every vector falls through to IL1..IL19).
# Per-vector log lands in testgen/run_all_logs/, summary TSV in
# testgen/run_all_summary.tsv. Exits non-zero if any vector failed.
#
#   make QUESTA=$$QUESTA testgen-run-all                # all (bfs + fuzz)
#   make QUESTA=$$QUESTA testgen-run-bfs                # bfs/ only
#   make QUESTA=$$QUESTA testgen-run-fuzz               # fuzz/ only
#   PER_VEC_TIMEOUT=300 make QUESTA=$$QUESTA testgen-run-all
testgen-run-all:
	QUESTA=$(QUESTA) ./$(TESTGEN)/run_all.sh

testgen-run-bfs:
	QUESTA=$(QUESTA) ./$(TESTGEN)/run_all.sh --bfs-only

testgen-run-fuzz:
	QUESTA=$(QUESTA) ./$(TESTGEN)/run_all.sh --fuzz-only

# Run only the Murphi-generated vectors (vectors_murphi/).
# Pair with COVERAGE=1 to collect per-vector .ucdb for the atomic +
# baseline covergroups, then `testgen-coverage-merge` + `-report`.
testgen-run-murphi:
	QUESTA=$(QUESTA) ./$(TESTGEN)/run_all.sh --murphi-only

# ── Exhaustive coverage ──────────────────────────────────────────────────────
# Burst vectors: for each non-denied REQ op, issue the same op N times
# back-to-back from the same RN-F. Stresses MSHR pipelining + snoop-filter
# consistency. Override N via BURST_N=<n>.
BURST_N ?= 5
testgen-burst:
	cd $(TESTGEN) && python3 ./gen_burst.py --burst $(BURST_N)

# Run every vector at every address in the sweep list. Exercises L3 set
# indexing, snoop-filter set indexing, and same-set/different-tag
# replacement. Override ADDRS to use a custom address list.
#   make QUESTA=$$QUESTA testgen-run-sweep
#   ADDRS="0x80000200 0x80100200" make QUESTA=$$QUESTA testgen-run-sweep
testgen-run-sweep:
	QUESTA=$(QUESTA) ./$(TESTGEN)/run_all.sh --sweep

# Run only burst vectors
testgen-run-burst:
	QUESTA=$(QUESTA) ./$(TESTGEN)/run_all.sh --burst-only

# Cross-RN-F concurrent-burst vectors (Option A). For each non-denied
# REQ op that both RN-Fs can issue from the FSM initial state, emits a
# vector that performs N rounds of {FORK peer, DRIVE self, JOIN, recover}.
# Both RN-Fs hit the HNF within ~1 cycle of each other per round —
# stresses snoop arbitration, cross-MSHR consistency, snoop-filter races
# under contended access to the same line.
CROSS_R ?= 5
testgen-cross:
	cd $(TESTGEN) && python3 ./gen_cross.py --rounds $(CROSS_R)

testgen-run-cross:
	QUESTA=$(QUESTA) ./$(TESTGEN)/run_all.sh --cross-only

# Smoke set — pick a few representative vectors across all categories
# for a quick sanity run (~1 min wall-clock). Use during iteration on
# the SC RN-F / replay path / oracle when the full ~100-vector batch
# is too slow.
testgen-run-smoke:
	QUESTA=$(QUESTA) ./$(TESTGEN)/run_all.sh --sample 8

# Run a hand-picked subset. SUBSET defaults to the same smoke selection;
# override with any --pattern / --sample / --limit combo.
#   make QUESTA=$$QUESTA testgen-run-subset SUBSET="--pattern 'UC_*'"
#   make QUESTA=$$QUESTA testgen-run-subset SUBSET="--limit 5 --bfs-only"
#   make QUESTA=$$QUESTA testgen-run-subset SUBSET="--sample 20"
SUBSET ?= --sample 8
testgen-run-subset:
	QUESTA=$(QUESTA) ./$(TESTGEN)/run_all.sh $(SUBSET)

# ── Coverage merge & report ──────────────────────────────────────────────────
# Per-vector UCDBs land in $(TESTGEN)/run_all_logs/<vector>.ucdb when the
# run was built+run with COVERAGE=1. Merge them into one summary UCDB and
# generate a text/HTML report.
COV_DIR    := $(TESTGEN)/run_all_logs
COV_MERGED := $(TESTGEN)/coverage.ucdb
COV_TXT    := $(TESTGEN)/coverage.txt
COV_HTML   := $(TESTGEN)/coverage_html

testgen-coverage-merge:
	@nfiles=$$(ls $(COV_DIR)/*.ucdb 2>/dev/null | wc -l); \
	if [ "$$nfiles" = "0" ]; then \
	    echo "ERROR: no UCDB files in $(COV_DIR)/. Run with COVERAGE=1 first." >&2; \
	    exit 1; \
	fi; \
	echo "[cov] merging $$nfiles UCDB files into $(COV_MERGED)"
	cd $(BUILD) && vcover merge -out ../$(COV_MERGED) ../$(COV_DIR)/*.ucdb

# Per-category sub-merges, useful for "what does <category> alone cover?"
testgen-coverage-merge-bfs:
	cd $(BUILD) && vcover merge -out ../$(TESTGEN)/coverage_bfs.ucdb $$(ls ../$(COV_DIR)/[A-Z]*.ucdb)

testgen-coverage-merge-burst:
	cd $(BUILD) && vcover merge -out ../$(TESTGEN)/coverage_burst.ucdb ../$(COV_DIR)/burst_*.ucdb

testgen-coverage-merge-cross:
	cd $(BUILD) && vcover merge -out ../$(TESTGEN)/coverage_cross.ucdb ../$(COV_DIR)/cross_*.ucdb

testgen-coverage-report: $(COV_MERGED)
	cd $(BUILD) && vcover report -details -all ../$(COV_MERGED) > ../$(COV_TXT)
	cd $(BUILD) && vcover report -html -htmldir ../$(COV_HTML) ../$(COV_MERGED)
	@echo "[cov] text:  $(COV_TXT)"
	@echo "[cov] html:  $(COV_HTML)/index.html"

# Machine-parseable XML dump of the merged coverage.
testgen-coverage-xml: $(COV_MERGED)
	cd $(BUILD) && vcover report -xml -output ../$(TESTGEN)/coverage.xml ../$(COV_MERGED)
	@echo "[cov] xml:   $(TESTGEN)/coverage.xml"

# One-line summary across all covergroups (total / hit / pct).
testgen-coverage-summary: $(COV_MERGED)
	cd $(BUILD) && vcover report -summary ../$(COV_MERGED)

$(COV_MERGED): ; $(MAKE) testgen-coverage-merge

# Remove generated vectors (keeps the .py / .yaml sources)
testgen-clean:
	rm -rf $(TESTGEN)/vectors/*.txt $(TESTGEN)/vectors/fuzz \
	       $(TESTGEN)/vectors/burst $(TESTGEN)/vectors/cross \
	       $(TESTGEN)/hnf_fsm.dot $(TESTGEN)/hnf_fsm.dot.png \
	       $(TESTGEN)/run_all_logs $(TESTGEN)/run_all_summary.tsv \
	       $(TESTGEN)/coverage.ucdb $(TESTGEN)/coverage.txt $(TESTGEN)/coverage_html
